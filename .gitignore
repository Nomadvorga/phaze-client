# Only sources, Gradle build files, licenses and this file are versioned.
/*
!/.gitignore
!/src/
!/gradle/
!/gradlew
!/gradlew.bat
!/build.gradle
!/settings.gradle
!/gradle.properties
!/LICENSE
!/THIRD_PARTY_LICENSES.md

# build.gradle reads these: signed module manifest verification and a test source.
!/scripts/
/scripts/*
!/scripts/module-manifest.mjs
!/scripts/PackPreviewAssetLogicTest.java
!/security/
/security/*
!/security/manifest-ed25519-public.pem

build/
.gradle/
*.class
*.log
*.jar
!/gradle/wrapper/gradle-wrapper.jar
*.zip
*.rar
